{
  "tools": [
    {
      "name": "create_task",
      "description": "Create a task in a project.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "dueDate": {
            "format": "date-time",
            "type": "string"
          },
          "priority": {
            "enum": [
              "no-priority",
              "low",
              "medium",
              "high",
              "urgent"
            ],
            "type": "string"
          },
          "projectId": {
            "minLength": 1,
            "type": "string"
          },
          "startDate": {
            "format": "date-time",
            "type": "string"
          },
          "status": {
            "minLength": 1,
            "type": "string"
          },
          "title": {
            "minLength": 1,
            "type": "string"
          },
          "userId": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "projectId",
          "title",
          "description",
          "priority",
          "status"
        ]
      }
    },
    {
      "name": "get_task",
      "description": "Get a task by ID.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "taskId": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "taskId"
        ]
      }
    },
    {
      "name": "update_task",
      "description": "Update a task (fetches current task, merges fields, then full update).",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "dueDate": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "position": {
            "type": "number"
          },
          "priority": {
            "enum": [
              "no-priority",
              "low",
              "medium",
              "high",
              "urgent"
            ],
            "type": "string"
          },
          "projectId": {
            "minLength": 1,
            "type": "string"
          },
          "startDate": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "minLength": 1,
            "type": "string"
          },
          "taskId": {
            "minLength": 1,
            "type": "string"
          },
          "title": {
            "minLength": 1,
            "type": "string"
          },
          "userId": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "taskId"
        ]
      }
    }
  ]
}
