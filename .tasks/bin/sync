#!/usr/bin/env python3
"""sync — the deterministic engine for this repo's markdown kanban workflow.

So far this lays the foundation only, not the real subcommands:

- TASK-004: a hand-rolled frontmatter parser/renderer and a loader that
  discovers SPEC/EPIC/TASK artifacts under `.tasks/`.
- TASK-005: the generated-region engine — find/replace/append the text
  between `<!-- BEGIN:name -->` / `<!-- END:name -->` markers that every
  renderer (epic `children`, spec `epics`, board panels) sits on.
- TASK-006: `derive_epic_status` (the seven ordered rules) and
  `reconcile_blocks` (making `blocks` the exact reverse of `blocked_by`) —
  pure functions over loaded records; neither writes anything.
- TASK-007: `render_epic_children` / `render_spec_epics` — the two
  non-board region bodies, meant to be handed to TASK-005's
  `replace_region`/`ensure_region`.

It imports nothing outside the Python standard library — see
`.tasks/specs/SPEC-001-llm-sdlc-workflow.md` §"The sync script" for why.

Later tasks add the actual subcommands (`next-id`, board rendering,
`check`, `archive` — TASK-008 through TASK-012). Running this file
directly today just discovers and summarizes the current artifacts, as a
smoke test that the parser/loader work end to end.
"""

from __future__ import annotations

import re
import sys
from dataclasses import dataclass, replace
from pathlib import Path
from typing import Any


class FrontmatterError(ValueError):
    """Raised when frontmatter falls outside the supported subset.

    The supported subset (SPEC-001 §"The sync script"): bare and quoted
    string scalars, `null`, `true`/`false`, integers, and single-level
    inline `[a, b, c]` lists of those scalars. Trailing `# comment` text is
    ignored on parse (and therefore not reproduced on render). Anything
    else — nested maps, block scalars (`|`/`>`), YAML anchors/aliases,
    multi-line values, tabs — is rejected with a specific error rather than
    silently misparsed.
    """


_KEY_LINE_RE = re.compile(r"^([A-Za-z_][A-Za-z0-9_]*):[ \t]*(.*)$")
_INT_RE = re.compile(r"^-?\d+$")
_BLOCK_SCALAR_PREFIXES = ("|", ">", "&", "*", "{", "}")


def _strip_comment(raw: str) -> str:
    """Drop a trailing ' # ...' comment, ignoring '#' inside a quoted string."""
    in_quotes = False
    for i, ch in enumerate(raw):
        if ch == '"':
            in_quotes = not in_quotes
        elif ch == "#" and not in_quotes and (i == 0 or raw[i - 1] in " \t"):
            return raw[:i].rstrip()
    return raw.rstrip()


def _parse_scalar(token: str) -> Any:
    token = token.strip()
    if token == "":
        raise FrontmatterError("empty scalar value")
    if token == "null":
        return None
    if token == "true":
        return True
    if token == "false":
        return False
    if token.startswith('"'):
        if not (token.endswith('"') and len(token) >= 2):
            raise FrontmatterError(f"unterminated quoted scalar: {token!r}")
        inner = token[1:-1]
        if '"' in inner:
            raise FrontmatterError(f"unsupported escaped quote in: {token!r}")
        return inner
    if token.startswith("'"):
        raise FrontmatterError(f"single-quoted scalars are not supported: {token!r}")
    if _INT_RE.match(token):
        return int(token)
    if any(token.startswith(p) for p in _BLOCK_SCALAR_PREFIXES):
        raise FrontmatterError(f"unsupported YAML feature: {token!r}")
    return token  # bare string, taken verbatim


def _parse_list(token: str) -> list[Any]:
    if not (token.startswith("[") and token.endswith("]")):
        raise FrontmatterError(f"unterminated list: {token!r}")
    inner = token[1:-1].strip()
    if inner == "":
        return []
    if "[" in inner or "]" in inner:
        raise FrontmatterError(f"nested lists are not supported: {token!r}")
    return [_parse_scalar(item) for item in inner.split(",")]


def _parse_value(raw: str) -> Any:
    raw = raw.strip()
    if raw == "":
        raise FrontmatterError("missing value")
    if raw.startswith("["):
        return _parse_list(raw)
    return _parse_scalar(raw)


def parse_frontmatter(text: str) -> tuple[dict[str, Any], str, list[str]]:
    """Split a file into (fields, body, key_order).

    `fields` is keyed by frontmatter key; `order` preserves the order keys
    appeared in, so `render_frontmatter` can round-trip a file byte-for-byte
    when it uses only the supported subset (SPEC-001's real task/epic/spec
    files and config.md do). Raises `FrontmatterError` — naming the exact
    line — for anything outside that subset.
    """
    if not text.startswith("---\n"):
        raise FrontmatterError("file does not start with a '---' frontmatter block")
    end = text.find("\n---\n", 4)
    if end == -1:
        raise FrontmatterError("frontmatter block is not closed with a '---' line")
    block = text[4:end]
    body = text[end + len("\n---\n"):]

    fields: dict[str, Any] = {}
    order: list[str] = []
    for lineno, line in enumerate(block.split("\n"), start=1):
        if line.strip() == "":
            continue
        if line[0] in " \t":
            raise FrontmatterError(
                f"line {lineno}: indentation / nested maps are not supported: {line!r}"
            )
        match = _KEY_LINE_RE.match(line)
        if not match:
            raise FrontmatterError(f"line {lineno}: not a 'key: value' line: {line!r}")
        key, rest = match.group(1), _strip_comment(match.group(2))
        try:
            value = _parse_value(rest)
        except FrontmatterError as exc:
            raise FrontmatterError(f"line {lineno} ({key}): {exc}") from exc
        if key in fields:
            raise FrontmatterError(f"line {lineno}: duplicate key {key!r}")
        fields[key] = value
        order.append(key)
    return fields, body, order


def _needs_quoting(s: str) -> bool:
    if s in ("null", "true", "false"):
        return True
    if _INT_RE.match(s):
        return True
    if s == "" or s[0] in " \t":
        return True
    if any(s.startswith(p) for p in ("[", *_BLOCK_SCALAR_PREFIXES, "'", '"')):
        return True
    return ":" in s or "#" in s


def render_value(value: Any) -> str:
    if value is None:
        return "null"
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, int):
        return str(value)
    if isinstance(value, list):
        return "[" + ", ".join(render_value(v) for v in value) + "]"
    if isinstance(value, str):
        if '"' in value:
            raise FrontmatterError(f"cannot render a string containing '\"': {value!r}")
        return f'"{value}"' if _needs_quoting(value) else value
    raise FrontmatterError(f"cannot render value of type {type(value).__name__}: {value!r}")


def render_frontmatter(fields: dict[str, Any], order: list[str] | None = None) -> str:
    """Inverse of `parse_frontmatter`'s field extraction: dict -> '---' block.

    `order` should normally be the `order` a prior `parse_frontmatter` call
    returned, so edited files keep their original key order.
    """
    keys = order if order is not None else list(fields.keys())
    if set(keys) != set(fields.keys()):
        raise FrontmatterError("`order` does not match the keys in `fields`")
    lines = ["---"]
    lines.extend(f"{key}: {render_value(fields[key])}" for key in keys)
    lines.append("---")
    return "\n".join(lines) + "\n"


_KIND_PATTERNS = {
    "spec": re.compile(r"^SPEC-\d+.*\.md$"),
    "epic": re.compile(r"^EPIC-\d+.*\.md$"),
    "task": re.compile(r"^TASK-\d+.*\.md$"),
}


def _kind_of(filename: str) -> str | None:
    for kind, pattern in _KIND_PATTERNS.items():
        if pattern.match(filename):
            return kind
    return None


@dataclass
class Artifact:
    """A loaded SPEC/EPIC/TASK file: its frontmatter, body, and location."""

    id: str
    kind: str  # "spec" | "epic" | "task"
    path: Path
    fields: dict[str, Any]
    order: list[str]
    body: str

    def write(self) -> None:
        """Write this artifact's current fields/body back to `self.path`."""
        self.path.write_text(render_frontmatter(self.fields, self.order) + self.body)


def discover(tasks_root: Path) -> dict[str, Artifact]:
    """Scan `.tasks/`, `.tasks/specs/`, and `.tasks/archive/` for artifacts.

    Returns a dict keyed by artifact id (e.g. "TASK-004"). Raises
    `FrontmatterError` on a malformed file, a file missing/misplaced its
    `id` field, or two files claiming the same id.
    """
    search_dirs = [tasks_root, tasks_root / "specs", tasks_root / "archive"]
    artifacts: dict[str, Artifact] = {}
    for directory in search_dirs:
        if not directory.is_dir():
            continue
        for path in sorted(directory.glob("*.md")):
            kind = _kind_of(path.name)
            if kind is None:
                continue
            text = path.read_text()
            try:
                fields, body, order = parse_frontmatter(text)
            except FrontmatterError as exc:
                raise FrontmatterError(f"{path}: {exc}") from exc
            art_id = fields.get("id")
            if not isinstance(art_id, str) or not art_id:
                raise FrontmatterError(f"{path}: missing or invalid 'id' field")
            if art_id in artifacts:
                raise FrontmatterError(
                    f"duplicate id {art_id!r}: {artifacts[art_id].path} and {path}"
                )
            artifacts[art_id] = Artifact(
                id=art_id, kind=kind, path=path, fields=fields, order=order, body=body
            )
    return artifacts


# ---------------------------------------------------------------------------
# Epic-status derivation and blocked_by/blocks reconciliation
# ---------------------------------------------------------------------------


class GraphError(ValueError):
    """Raised for a referential problem in the task dependency graph — e.g. a
    `blocked_by` id that doesn't correspond to any loaded task. Distinct from
    `FrontmatterError`: the frontmatter parsed fine, the *graph* is unsound.
    """


_EPIC_ACTIVE_STATUSES = ("in-progress", "in-review")
_EPIC_TERMINAL_HUMAN_STATUS = "wont-do"


def derive_epic_status(epic: Artifact, children: list[Artifact]) -> Artifact:
    """Compute an epic's status from its children's `status` fields.

    Implements the seven ordered rules of SPEC-001 §'Epic status
    derivation'; the first match wins:

    1. the epic's current status is already `wont-do` -> stays `wont-do`
       (a human cancelled it; `sync` never overwrites that decision)
    2. no children, or every child `todo` -> `todo`
    3. any child `in-progress` or `in-review` -> `in-progress`
    4. >=1 child, every child `blocked` -> `blocked`
    5. >=1 child, every child `wont-do` -> `wont-do`
    6. >=1 child, every child `done`/`wont-do`, >=1 `done` -> `done`
    7. otherwise (a mix involving `todo`, none currently active) -> `in-progress`

    A pure function: returns a *new* Artifact — a copy of `epic` with
    `fields['status']` set — rather than writing anything or mutating the
    argument. `children` should be exactly the tasks whose `epic` field
    names this epic; the caller (a later task) is responsible for that
    filtering.
    """
    if epic.fields.get("status") == _EPIC_TERMINAL_HUMAN_STATUS:
        new_status = _EPIC_TERMINAL_HUMAN_STATUS  # rule 1
    else:
        statuses = [child.fields.get("status") for child in children]
        if not statuses or all(s == "todo" for s in statuses):
            new_status = "todo"  # rule 2
        elif any(s in _EPIC_ACTIVE_STATUSES for s in statuses):
            new_status = "in-progress"  # rule 3
        elif all(s == "blocked" for s in statuses):
            new_status = "blocked"  # rule 4
        elif all(s == "wont-do" for s in statuses):
            new_status = "wont-do"  # rule 5
        elif all(s in ("done", "wont-do") for s in statuses) and any(s == "done" for s in statuses):
            new_status = "done"  # rule 6
        else:
            new_status = "in-progress"  # rule 7: catch-all
    return replace(epic, fields={**epic.fields, "status": new_status})


def reconcile_blocks(tasks: dict[str, Artifact]) -> dict[str, Artifact]:
    """Recompute every task's `blocks` list as the exact reverse of every
    `blocked_by` edge (SPEC-001 §'Relationships — stored on the child only'):
    `blocked_by` is the source of truth, so a pre-existing `blocks` value
    that disagrees is overwritten, not merged. Each recomputed list is
    sorted (matching this repo's own convention of ascending task ids).

    Returns a new `{id: Artifact}` dict — a pure function, like
    `derive_epic_status`; nothing is written to disk. Raises `GraphError`
    naming the offending file if any task's `blocked_by` references an id
    not present in `tasks`.
    """
    inbound: dict[str, list[str]] = {task_id: [] for task_id in tasks}
    for task_id, art in tasks.items():
        for dep in art.fields.get("blocked_by", []):
            if dep not in tasks:
                raise GraphError(f"{art.path}: blocked_by references unknown task {dep!r}")
            inbound[dep].append(task_id)
    return {
        task_id: replace(art, fields={**art.fields, "blocks": sorted(inbound[task_id])})
        for task_id, art in tasks.items()
    }


# ---------------------------------------------------------------------------
# Generated regions: <!-- BEGIN:name --> ... <!-- END:name -->
# ---------------------------------------------------------------------------


class RegionError(ValueError):
    """Raised for a malformed or missing generated-region marker pair.

    Not raised for "the region doesn't exist yet and I have no anchor to
    place it at" during normal operation — that path is `ensure_region`,
    which is explicitly designed for the not-yet-created case.
    """


@dataclass(frozen=True)
class RegionSpan:
    """Byte offsets of one `BEGIN:name`/`END:name` marker pair in a document."""

    begin_start: int  # index of '<!-- BEGIN:name'
    begin_end: int  # index just after the BEGIN line's own trailing newline
    end_start: int  # index of '<!-- END:name'
    end_end: int  # index just after the END line's own trailing newline


def _fenced_code_ranges(text: str) -> list[tuple[int, int]]:
    """Character ranges covered by ` ``` ` fenced code blocks.

    A markdown file documenting the marker syntax (e.g. SPEC-001's own
    "Generated regions" and "Epics panel" examples) can contain literal
    `<!-- BEGIN:name -->` text as an illustration, not a real region. Found
    while running TASK-007's own testing strategy against SPEC-001 — its
    two fenced examples were misread as live `children`/`epics` regions.
    Each range spans the opening ` ``` ` line through the closing one.
    An unterminated trailing fence (no closing ` ``` `) is not treated as
    fenced, since there is nothing to exclude a match from.
    """
    ranges = []
    pos = 0
    while True:
        open_idx = text.find("```", pos)
        if open_idx == -1:
            break
        open_line_end = text.find("\n", open_idx)
        if open_line_end == -1:
            break
        close_idx = text.find("```", open_line_end + 1)
        if close_idx == -1:
            break
        close_line_end = text.find("\n", close_idx)
        end = len(text) if close_line_end == -1 else close_line_end + 1
        ranges.append((open_idx, end))
        pos = end
    return ranges


def _find_marker(
    text: str, tag: str, name: str, start: int = 0, exclude_ranges: tuple[tuple[int, int], ...] = ()
) -> tuple[int, int] | None:
    """Find a line of the form ``<!-- TAG:name ... -->`` at or after `start`.

    Returns `(line_start, index_just_past_the_line)`, or None if no line
    begins with the prefix. The comment may carry arbitrary trailing text
    before its closing `-->` (e.g. "(generated by sync — do not edit)") —
    only the `<!-- TAG:name` prefix and a `-->` somewhere on the same line
    are required, which is what lets `find_region` "tolerate extra text
    after the name inside the BEGIN comment." Matches inside `exclude_ranges`
    (fenced code blocks — see `_fenced_code_ranges`) are skipped.
    """
    prefix = f"<!-- {tag}:{name}"
    idx = start
    while True:
        idx = text.find(prefix, idx)
        if idx == -1:
            return None
        at_line_start = idx == 0 or text[idx - 1] == "\n"
        end_of_prefix = idx + len(prefix)
        name_boundary_ok = end_of_prefix >= len(text) or text[end_of_prefix] == " "
        in_fenced_block = any(lo <= idx < hi for lo, hi in exclude_ranges)
        if not at_line_start or not name_boundary_ok or in_fenced_block:
            # Either mid-line, `name` is only a prefix of a longer name (e.g.
            # "epics" inside "epics2"), or inside a fenced doc example — keep looking.
            idx += 1
            continue
        newline = text.find("\n", idx)
        line = text[idx:] if newline == -1 else text[idx:newline]
        if "-->" not in line:
            raise RegionError(f"{tag}:{name} marker line is not closed with '-->': {line!r}")
        return idx, (len(text) if newline == -1 else newline + 1)


def find_region(text: str, name: str) -> RegionSpan | None:
    """Locate the `BEGIN:name`/`END:name` marker pair in `text`.

    Returns `None` if no `BEGIN:name` line exists outside a fenced code
    block. Raises `RegionError` if `BEGIN:name` exists with no matching
    `END:name` after it.
    """
    fenced = tuple(_fenced_code_ranges(text))
    begin = _find_marker(text, "BEGIN", name, exclude_ranges=fenced)
    if begin is None:
        return None
    begin_start, begin_end = begin
    end = _find_marker(text, "END", name, start=begin_end, exclude_ranges=fenced)
    if end is None:
        raise RegionError(f"BEGIN:{name} found with no matching END:{name}")
    end_start, end_end = end
    return RegionSpan(begin_start, begin_end, end_start, end_end)


def _render_region_content(body: str) -> str:
    """SPEC-001 §'Rendering details': no leading blank line after BEGIN, a
    single trailing newline before END, and `_(none)_` for an empty body.
    """
    return (body if body else "_(none)_") + "\n"


def replace_region(text: str, name: str, body: str) -> str:
    """Replace the content of an existing `BEGIN:name`/`END:name` region.

    Only the lines strictly between the markers change. Returns `text`
    unchanged (same object) when the rendered content already matches —
    byte-for-byte — so a second call with the same `body` is always a
    true no-op. Raises `RegionError` if the region doesn't exist; use
    `ensure_region` when it might not.
    """
    span = find_region(text, name)
    if span is None:
        raise RegionError(f"no BEGIN:{name}/END:{name} region to replace")
    rendered = _render_region_content(body)
    if text[span.begin_end:span.end_start] == rendered:
        return text
    return text[:span.begin_end] + rendered + text[span.end_start:]


def ensure_region(text: str, name: str, body: str, anchor: str | None = None) -> str:
    """Ensure a `BEGIN:name`/`END:name` region exists, with `body` as its content.

    If the region already exists, this is exactly `replace_region`. If it
    doesn't, a new region is inserted immediately after the first
    occurrence of `anchor` (e.g. anchor="## In Progress\\n\\n" places it
    right under that heading) — or at the end of the document if `anchor`
    is None. Raises `RegionError` if `anchor` is given but not found in
    `text`: guessing a placement for a caller-specified anchor would be
    worse than failing loudly.
    """
    if find_region(text, name) is not None:
        return replace_region(text, name, body)
    block = f"<!-- BEGIN:{name} (generated by sync — do not edit) -->\n{_render_region_content(body)}<!-- END:{name} -->\n"
    if anchor is None:
        if text and not text.endswith("\n"):
            return text + "\n" + block
        return text + block
    idx = text.find(anchor)
    if idx == -1:
        raise RegionError(f"anchor not found for new region {name!r}: {anchor!r}")
    insert_at = idx + len(anchor)
    return text[:insert_at] + block + text[insert_at:]


# ---------------------------------------------------------------------------
# Epic `children` and spec `epics` region renderers
# ---------------------------------------------------------------------------


def _reject_pipe(value: Any, what: str) -> None:
    """Refuse a value that would silently break a markdown table row."""
    if isinstance(value, str) and "|" in value:
        raise RegionError(f"{what} contains '|', which would break a markdown table: {value!r}")


def _epic_progress(children: list[Artifact]) -> tuple[int, int]:
    """(done_count, total_count) for an epic's children.

    `done_count` includes `wont-do` children too (SPEC-001 §'Generated
    regions': "`done` counts `done`+`wont-do`") -- an abandoned task still
    counts as no-longer-outstanding work for progress purposes.
    """
    total = len(children)
    done = sum(1 for c in children if c.fields.get("status") in ("done", "wont-do"))
    return done, total


def render_epic_children(epic: Artifact, children: list[Artifact]) -> str:
    """Render the body of an epic's `children` region (SPEC-001 §'Generated
    regions'): a `| Task | Status | Title |` table ordered by id, a blank
    line, then `Progress: <done>/<total> done`.

    `children` should be exactly the tasks whose `epic` field names this
    epic (same contract as `derive_epic_status`) -- this function does not
    filter, only renders. Returns `""` for a childless epic; the region
    engine renders an empty body as `_(none)_`.
    """
    if not children:
        return ""
    ordered = sorted(children, key=lambda task: task.id)
    for task in ordered:
        _reject_pipe(task.fields.get("title"), f"{task.id} title")
    rows = "\n".join(
        f"| {task.id} | {task.fields.get('status')} | {task.fields.get('title')} |"
        for task in ordered
    )
    done, total = _epic_progress(ordered)
    return f"| Task | Status | Title |\n|---|---|---|\n{rows}\n\nProgress: {done}/{total} done"


def render_spec_epics(epics_with_children: list[tuple[Artifact, list[Artifact]]]) -> str:
    """Render the body of a spec's `epics` region: a `| Epic | Status |
    Progress |` table ordered by epic id, mirroring the board's `epics`
    panel format.

    `epics_with_children` is `(epic, epic's children)` pairs for every
    epic whose `spec` field names this spec; each `epic` is expected to
    already carry its *derived* status (i.e. the caller ran
    `derive_epic_status` first — this function only renders, matching
    `render_epic_children`'s division of labor). Returns `""` when there
    are no linked epics.
    """
    if not epics_with_children:
        return ""
    ordered = sorted(epics_with_children, key=lambda pair: pair[0].id)
    rows = []
    for epic, children in ordered:
        _reject_pipe(epic.fields.get("title"), f"{epic.id} title")
        done, total = _epic_progress(children)
        rows.append(f"| {epic.id} | {epic.fields.get('status')} | {done}/{total} done |")
    return "| Epic | Status | Progress |\n|---|---|---|\n" + "\n".join(rows)


def main(argv: list[str]) -> int:
    if argv:
        print(f"sync: no subcommands yet (got {argv!r}) — TASK-006 onward add them", file=sys.stderr)
        return 2
    tasks_root = Path(__file__).resolve().parent.parent
    artifacts = discover(tasks_root)
    by_kind: dict[str, int] = {}
    for art in artifacts.values():
        by_kind[art.kind] = by_kind.get(art.kind, 0) + 1
    print(f"Discovered {len(artifacts)} artifact(s) under {tasks_root}:")
    for kind in ("spec", "epic", "task"):
        print(f"  {kind}: {by_kind.get(kind, 0)}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
