#!/usr/bin/env python3
"""sync — the deterministic engine for the markdown kanban workflow.

Provides:

- A hand-rolled frontmatter parser/renderer and a loader that discovers
  SPEC/EPIC/TASK artifacts under `.tasks/`.
- The generated-region engine — find/replace/append the text between
  `<!-- BEGIN:name -->` / `<!-- END:name -->` markers that every renderer
  (epic `children`, spec `epics`, board panels) sits on.
- `derive_epic_status` (the seven ordered rules) and `reconcile_blocks`
  (making `blocks` the exact reverse of `blocked_by`) — pure functions
  over loaded records; neither writes anything.
- `render_epic_children` / `render_spec_epics` — the two non-board region
  bodies, handed to the region engine's `replace_region`/`ensure_region`.
- `render_board_epics_panel` / `render_board_column` — BOARD.md's
  roll-up panel and its four fully-generated status columns.
- `merge_todo` / `apply_todo_merge` — the one place `sync` merges instead
  of regenerating: reconciles the hand-ordered TODO list with reality
  without ever reordering it.
- `sync next-id <spec|epic|task>` — the next free id of a type,
  scanning `.tasks/`, `.tasks/specs/`, and `.tasks/archive/` so an id is
  never reused after archiving.
- `sync archive` — moves `done`/`wont-do` task files into
  `.tasks/archive/`, preserving filename and frontmatter untouched.
- `compute_mismatches` / `sync check` — runs every derivation and
  renderer above in memory and diffs the result against disk,
  writing nothing.
- `apply_all` / `run_sync` — the write mode: applies every mismatch
  `compute_mismatches` would report (chaining a file's updates where more
  than one applies, e.g. BOARD.md's several regions), then archives if
  configured. Bare `.tasks/bin/sync` (no arguments) runs this now.

It imports nothing outside the Python standard library, to stay
dependency-free for any project it's vendored into.
"""

from __future__ import annotations

import difflib
import re
import sys
from dataclasses import dataclass, replace
from pathlib import Path
from typing import Any


class FrontmatterError(ValueError):
    """Raised when frontmatter falls outside the supported subset.

    The supported subset: bare and quoted string scalars, `null`,
    `true`/`false`, integers, and single-level inline `[a, b, c]` lists of
    those scalars. Trailing `# comment` text is
    ignored on parse (and therefore not reproduced on render). Anything
    else — nested maps, block scalars (`|`/`>`), YAML anchors/aliases,
    multi-line values, tabs — is rejected with a specific error rather than
    silently misparsed.
    """


_KEY_LINE_RE = re.compile(r"^([A-Za-z_][A-Za-z0-9_]*):[ \t]*(.*)$")
_INT_RE = re.compile(r"^-?\d+$")
_BLOCK_SCALAR_PREFIXES = ("|", ">", "&", "*", "{", "}")


def _strip_comment(raw: str) -> str:
    """Drop a trailing ' # ...' comment, ignoring '#' inside a quoted string."""
    in_quotes = False
    for i, ch in enumerate(raw):
        if ch == '"':
            in_quotes = not in_quotes
        elif ch == "#" and not in_quotes and (i == 0 or raw[i - 1] in " \t"):
            return raw[:i].rstrip()
    return raw.rstrip()


def _parse_scalar(token: str) -> Any:
    token = token.strip()
    if token == "":
        raise FrontmatterError("empty scalar value")
    if token == "null":
        return None
    if token == "true":
        return True
    if token == "false":
        return False
    if token.startswith('"'):
        if not (token.endswith('"') and len(token) >= 2):
            raise FrontmatterError(f"unterminated quoted scalar: {token!r}")
        inner = token[1:-1]
        if '"' in inner:
            raise FrontmatterError(f"unsupported escaped quote in: {token!r}")
        return inner
    if token.startswith("'"):
        raise FrontmatterError(f"single-quoted scalars are not supported: {token!r}")
    if _INT_RE.match(token):
        return int(token)
    if any(token.startswith(p) for p in _BLOCK_SCALAR_PREFIXES):
        raise FrontmatterError(f"unsupported YAML feature: {token!r}")
    return token  # bare string, taken verbatim


def _parse_list(token: str) -> list[Any]:
    if not (token.startswith("[") and token.endswith("]")):
        raise FrontmatterError(f"unterminated list: {token!r}")
    inner = token[1:-1].strip()
    if inner == "":
        return []
    if "[" in inner or "]" in inner:
        raise FrontmatterError(f"nested lists are not supported: {token!r}")
    return [_parse_scalar(item) for item in inner.split(",")]


def _parse_value(raw: str) -> Any:
    raw = raw.strip()
    if raw == "":
        raise FrontmatterError("missing value")
    if raw.startswith("["):
        return _parse_list(raw)
    return _parse_scalar(raw)


def parse_frontmatter(text: str) -> tuple[dict[str, Any], str, list[str]]:
    """Split a file into (fields, body, key_order).

    `fields` is keyed by frontmatter key; `order` preserves the order keys
    appeared in, so `render_frontmatter` can round-trip a file byte-for-byte
    when it uses only the supported subset (real task/epic/spec files and
    config.md do). Raises `FrontmatterError` — naming the exact
    line — for anything outside that subset.
    """
    if not text.startswith("---\n"):
        raise FrontmatterError("file does not start with a '---' frontmatter block")
    end = text.find("\n---\n", 4)
    if end == -1:
        raise FrontmatterError("frontmatter block is not closed with a '---' line")
    block = text[4:end]
    body = text[end + len("\n---\n"):]

    fields: dict[str, Any] = {}
    order: list[str] = []
    for lineno, line in enumerate(block.split("\n"), start=1):
        if line.strip() == "":
            continue
        if line[0] in " \t":
            raise FrontmatterError(
                f"line {lineno}: indentation / nested maps are not supported: {line!r}"
            )
        match = _KEY_LINE_RE.match(line)
        if not match:
            raise FrontmatterError(f"line {lineno}: not a 'key: value' line: {line!r}")
        key, rest = match.group(1), _strip_comment(match.group(2))
        try:
            value = _parse_value(rest)
        except FrontmatterError as exc:
            raise FrontmatterError(f"line {lineno} ({key}): {exc}") from exc
        if key in fields:
            raise FrontmatterError(f"line {lineno}: duplicate key {key!r}")
        fields[key] = value
        order.append(key)
    return fields, body, order


def _needs_quoting(s: str) -> bool:
    if s in ("null", "true", "false"):
        return True
    if _INT_RE.match(s):
        return True
    if s == "" or s[0] in " \t":
        return True
    if any(s.startswith(p) for p in ("[", *_BLOCK_SCALAR_PREFIXES, "'", '"')):
        return True
    return ":" in s or "#" in s


def render_value(value: Any) -> str:
    if value is None:
        return "null"
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, int):
        return str(value)
    if isinstance(value, list):
        return "[" + ", ".join(render_value(v) for v in value) + "]"
    if isinstance(value, str):
        if '"' in value:
            raise FrontmatterError(f"cannot render a string containing '\"': {value!r}")
        return f'"{value}"' if _needs_quoting(value) else value
    raise FrontmatterError(f"cannot render value of type {type(value).__name__}: {value!r}")


def render_frontmatter(fields: dict[str, Any], order: list[str] | None = None) -> str:
    """Inverse of `parse_frontmatter`'s field extraction: dict -> '---' block.

    `order` should normally be the `order` a prior `parse_frontmatter` call
    returned, so edited files keep their original key order.
    """
    keys = order if order is not None else list(fields.keys())
    if set(keys) != set(fields.keys()):
        raise FrontmatterError("`order` does not match the keys in `fields`")
    lines = ["---"]
    lines.extend(f"{key}: {render_value(fields[key])}" for key in keys)
    lines.append("---")
    return "\n".join(lines) + "\n"


_KIND_PATTERNS = {
    "spec": re.compile(r"^SPEC-\d+.*\.md$"),
    "epic": re.compile(r"^EPIC-\d+.*\.md$"),
    "task": re.compile(r"^TASK-\d+.*\.md$"),
}


def _kind_of(filename: str) -> str | None:
    for kind, pattern in _KIND_PATTERNS.items():
        if pattern.match(filename):
            return kind
    return None


@dataclass
class Artifact:
    """A loaded SPEC/EPIC/TASK file: its frontmatter, body, and location."""

    id: str
    kind: str  # "spec" | "epic" | "task"
    path: Path
    fields: dict[str, Any]
    order: list[str]
    body: str

    def write(self) -> None:
        """Write this artifact's current fields/body back to `self.path`."""
        self.path.write_text(render_frontmatter(self.fields, self.order) + self.body)


def discover(tasks_root: Path) -> dict[str, Artifact]:
    """Scan `.tasks/`, `.tasks/specs/`, and `.tasks/archive/` for artifacts.

    Returns a dict keyed by artifact id (e.g. "TASK-NNN"). Raises
    `FrontmatterError` on a malformed file, a file missing/misplaced its
    `id` field, or two files claiming the same id.
    """
    search_dirs = [tasks_root, tasks_root / "specs", tasks_root / "archive"]
    artifacts: dict[str, Artifact] = {}
    for directory in search_dirs:
        if not directory.is_dir():
            continue
        for path in sorted(directory.glob("*.md")):
            kind = _kind_of(path.name)
            if kind is None:
                continue
            text = path.read_text()
            try:
                fields, body, order = parse_frontmatter(text)
            except FrontmatterError as exc:
                raise FrontmatterError(f"{path}: {exc}") from exc
            art_id = fields.get("id")
            if not isinstance(art_id, str) or not art_id:
                raise FrontmatterError(f"{path}: missing or invalid 'id' field")
            if art_id in artifacts:
                raise FrontmatterError(
                    f"duplicate id {art_id!r}: {artifacts[art_id].path} and {path}"
                )
            artifacts[art_id] = Artifact(
                id=art_id, kind=kind, path=path, fields=fields, order=order, body=body
            )
    return artifacts


_ID_KIND_PREFIXES = {"spec": "SPEC", "epic": "EPIC", "task": "TASK"}


def next_id(tasks_root: Path, kind: str) -> str:
    """The next free id for `kind` ('spec' | 'epic' | 'task'): the max
    existing id of that kind across `.tasks/`, `.tasks/specs/`, and
    `.tasks/archive/`, plus 1, zero-padded to three digits. Archived files
    count too -- an id is never reused.

    Raises `ValueError` for a `kind` outside `spec`/`epic`/`task`.
    """
    if kind not in _ID_KIND_PREFIXES:
        raise ValueError(f"unknown id type {kind!r} — expected one of: {', '.join(sorted(_ID_KIND_PREFIXES))}")
    prefix = _ID_KIND_PREFIXES[kind]
    artifacts = discover(tasks_root)
    existing = [int(art.id.split("-", 1)[1]) for art in artifacts.values() if art.kind == kind]
    return f"{prefix}-{max(existing, default=0) + 1:03d}"


# ---------------------------------------------------------------------------
# Archiving done/wont-do tasks
# ---------------------------------------------------------------------------


_ARCHIVABLE_STATUSES = ("done", "wont-do")


def find_archivable(tasks_root: Path) -> dict[str, Artifact]:
    """Tasks whose status is `done` or `wont-do` and aren't already under
    `.tasks/archive/`. What `archive()` would move, without moving it.
    """
    archive_dir = (tasks_root / "archive").resolve()
    return {
        task_id: art
        for task_id, art in discover(tasks_root).items()
        if art.kind == "task"
        and art.fields.get("status") in _ARCHIVABLE_STATUSES
        and archive_dir not in art.path.resolve().parents
    }


def archive(tasks_root: Path) -> list[Path]:
    """Move every `done`/`wont-do` task file into `.tasks/archive/`,
    preserving its filename and frontmatter untouched. Idempotent --
    already-archived files are skipped, so a second run moves nothing.
    Returns the destination paths of files actually moved.

    Task frontmatter (title, `pr`) is left exactly as it was: the moved
    file itself is the durable one-line reference needed once a task
    ages out of BOARD.md's capped `done` column -- while still within
    the cap, `render_board_column` already surfaces title
    and `pr` for every done task regardless of file location, since
    `discover()` scans `.tasks/archive/` too. No separate archive index
    is created.

    Does not update BOARD.md or any other file -- that's the (not yet
    built) write mode's job, once it exists; see the module docstring.
    """
    archive_dir = tasks_root / "archive"
    moved = []
    for art in find_archivable(tasks_root).values():
        archive_dir.mkdir(parents=True, exist_ok=True)
        dest = archive_dir / art.path.name
        art.path.rename(dest)
        moved.append(dest)
    return moved


def should_auto_archive(config: dict[str, Any]) -> bool:
    """Whether a bare `sync` write mode should call `archive()`
    automatically, per `config.md`'s `archive_done` key (default `True`
    if unset). `sync archive`, invoked directly, always archives
    regardless of this -- it exists precisely so archiving still works
    when auto-archiving is turned off. Exposed as its own function so
    it's already implemented and tested for whenever bare `sync` gains a
    write mode (not yet built; see the module docstring).
    """
    return bool(config.get("archive_done", True))


# ---------------------------------------------------------------------------
# Epic-status derivation and blocked_by/blocks reconciliation
# ---------------------------------------------------------------------------


class GraphError(ValueError):
    """Raised for a referential problem in the task dependency graph — e.g. a
    `blocked_by` id that doesn't correspond to any loaded task. Distinct from
    `FrontmatterError`: the frontmatter parsed fine, the *graph* is unsound.
    """


_EPIC_ACTIVE_STATUSES = ("in-progress", "in-review")
_EPIC_TERMINAL_HUMAN_STATUS = "wont-do"


def derive_epic_status(epic: Artifact, children: list[Artifact]) -> Artifact:
    """Compute an epic's status from its children's `status` fields.

    Implements the seven ordered epic-status-derivation rules; the first
    match wins:

    1. the epic's current status is already `wont-do` -> stays `wont-do`
       (a human cancelled it; `sync` never overwrites that decision)
    2. no children, or every child `todo` -> `todo`
    3. any child `in-progress` or `in-review` -> `in-progress`
    4. >=1 child, every child `blocked` -> `blocked`
    5. >=1 child, every child `wont-do` -> `wont-do`
    6. >=1 child, every child `done`/`wont-do`, >=1 `done` -> `done`
    7. otherwise (a mix involving `todo`, none currently active) -> `in-progress`

    A pure function: returns a *new* Artifact — a copy of `epic` with
    `fields['status']` set — rather than writing anything or mutating the
    argument. `children` should be exactly the tasks whose `epic` field
    names this epic; the caller (a later task) is responsible for that
    filtering.
    """
    if epic.fields.get("status") == _EPIC_TERMINAL_HUMAN_STATUS:
        new_status = _EPIC_TERMINAL_HUMAN_STATUS  # rule 1
    else:
        statuses = [child.fields.get("status") for child in children]
        if not statuses or all(s == "todo" for s in statuses):
            new_status = "todo"  # rule 2
        elif any(s in _EPIC_ACTIVE_STATUSES for s in statuses):
            new_status = "in-progress"  # rule 3
        elif all(s == "blocked" for s in statuses):
            new_status = "blocked"  # rule 4
        elif all(s == "wont-do" for s in statuses):
            new_status = "wont-do"  # rule 5
        elif all(s in ("done", "wont-do") for s in statuses) and any(s == "done" for s in statuses):
            new_status = "done"  # rule 6
        else:
            new_status = "in-progress"  # rule 7: catch-all
    return replace(epic, fields={**epic.fields, "status": new_status})


def reconcile_blocks(tasks: dict[str, Artifact]) -> dict[str, Artifact]:
    """Recompute every task's `blocks` list as the exact reverse of every
    `blocked_by` edge (a relationship stored on the child only):
    `blocked_by` is the source of truth, so a pre-existing `blocks` value
    that disagrees is overwritten, not merged. Each recomputed list is
    sorted (ascending task ids).

    Returns a new `{id: Artifact}` dict — a pure function, like
    `derive_epic_status`; nothing is written to disk. Raises `GraphError`
    naming the offending file if any task's `blocked_by` references an id
    not present in `tasks`.
    """
    inbound: dict[str, list[str]] = {task_id: [] for task_id in tasks}
    for task_id, art in tasks.items():
        for dep in art.fields.get("blocked_by", []):
            if dep not in tasks:
                raise GraphError(f"{art.path}: blocked_by references unknown task {dep!r}")
            inbound[dep].append(task_id)
    return {
        task_id: replace(art, fields={**art.fields, "blocks": sorted(inbound[task_id])})
        for task_id, art in tasks.items()
    }


# ---------------------------------------------------------------------------
# Generated regions: <!-- BEGIN:name --> ... <!-- END:name -->
# ---------------------------------------------------------------------------


class RegionError(ValueError):
    """Raised for a malformed or missing generated-region marker pair.

    Not raised for "the region doesn't exist yet and I have no anchor to
    place it at" during normal operation — that path is `ensure_region`,
    which is explicitly designed for the not-yet-created case.
    """


@dataclass(frozen=True)
class RegionSpan:
    """Byte offsets of one `BEGIN:name`/`END:name` marker pair in a document."""

    begin_start: int  # index of '<!-- BEGIN:name'
    begin_end: int  # index just after the BEGIN line's own trailing newline
    end_start: int  # index of '<!-- END:name'
    end_end: int  # index just after the END line's own trailing newline


def _fenced_code_ranges(text: str) -> list[tuple[int, int]]:
    """Character ranges covered by ` ``` ` fenced code blocks.

    A markdown file documenting the marker syntax can contain literal
    `<!-- BEGIN:name -->` text as an illustration, not a real region --
    a fenced example like that would otherwise be misread as a live
    `children`/`epics` region. Each range spans the opening ` ``` ` line
    through the closing one.
    An unterminated trailing fence (no closing ` ``` `) is not treated as
    fenced, since there is nothing to exclude a match from.
    """
    ranges = []
    pos = 0
    while True:
        open_idx = text.find("```", pos)
        if open_idx == -1:
            break
        open_line_end = text.find("\n", open_idx)
        if open_line_end == -1:
            break
        close_idx = text.find("```", open_line_end + 1)
        if close_idx == -1:
            break
        close_line_end = text.find("\n", close_idx)
        end = len(text) if close_line_end == -1 else close_line_end + 1
        ranges.append((open_idx, end))
        pos = end
    return ranges


def _find_marker(
    text: str, tag: str, name: str, start: int = 0, exclude_ranges: tuple[tuple[int, int], ...] = ()
) -> tuple[int, int] | None:
    """Find a line of the form ``<!-- TAG:name ... -->`` at or after `start`.

    Returns `(line_start, index_just_past_the_line)`, or None if no line
    begins with the prefix. The comment may carry arbitrary trailing text
    before its closing `-->` (e.g. "(generated by sync — do not edit)") —
    only the `<!-- TAG:name` prefix and a `-->` somewhere on the same line
    are required, which is what lets `find_region` "tolerate extra text
    after the name inside the BEGIN comment." Matches inside `exclude_ranges`
    (fenced code blocks — see `_fenced_code_ranges`) are skipped.
    """
    prefix = f"<!-- {tag}:{name}"
    idx = start
    while True:
        idx = text.find(prefix, idx)
        if idx == -1:
            return None
        at_line_start = idx == 0 or text[idx - 1] == "\n"
        end_of_prefix = idx + len(prefix)
        name_boundary_ok = end_of_prefix >= len(text) or text[end_of_prefix] == " "
        in_fenced_block = any(lo <= idx < hi for lo, hi in exclude_ranges)
        if not at_line_start or not name_boundary_ok or in_fenced_block:
            # Either mid-line, `name` is only a prefix of a longer name (e.g.
            # "epics" inside "epics2"), or inside a fenced doc example — keep looking.
            idx += 1
            continue
        newline = text.find("\n", idx)
        line = text[idx:] if newline == -1 else text[idx:newline]
        if "-->" not in line:
            raise RegionError(f"{tag}:{name} marker line is not closed with '-->': {line!r}")
        return idx, (len(text) if newline == -1 else newline + 1)


def find_region(text: str, name: str) -> RegionSpan | None:
    """Locate the `BEGIN:name`/`END:name` marker pair in `text`.

    Returns `None` if no `BEGIN:name` line exists outside a fenced code
    block. Raises `RegionError` if `BEGIN:name` exists with no matching
    `END:name` after it.
    """
    fenced = tuple(_fenced_code_ranges(text))
    begin = _find_marker(text, "BEGIN", name, exclude_ranges=fenced)
    if begin is None:
        return None
    begin_start, begin_end = begin
    end = _find_marker(text, "END", name, start=begin_end, exclude_ranges=fenced)
    if end is None:
        raise RegionError(f"BEGIN:{name} found with no matching END:{name}")
    end_start, end_end = end
    return RegionSpan(begin_start, begin_end, end_start, end_end)


def _render_region_content(body: str) -> str:
    """Rendering details: no leading blank line after BEGIN, a single
    trailing newline before END, and `_(none)_` for an empty body.
    """
    return (body if body else "_(none)_") + "\n"


def replace_region(text: str, name: str, body: str) -> str:
    """Replace the content of an existing `BEGIN:name`/`END:name` region.

    Only the lines strictly between the markers change. Returns `text`
    unchanged (same object) when the rendered content already matches —
    byte-for-byte — so a second call with the same `body` is always a
    true no-op. Raises `RegionError` if the region doesn't exist; use
    `ensure_region` when it might not.
    """
    span = find_region(text, name)
    if span is None:
        raise RegionError(f"no BEGIN:{name}/END:{name} region to replace")
    rendered = _render_region_content(body)
    if text[span.begin_end:span.end_start] == rendered:
        return text
    return text[:span.begin_end] + rendered + text[span.end_start:]


def ensure_region(text: str, name: str, body: str, anchor: str | None = None) -> str:
    """Ensure a `BEGIN:name`/`END:name` region exists, with `body` as its content.

    If the region already exists, this is exactly `replace_region`. If it
    doesn't, a new region is inserted immediately after the first
    occurrence of `anchor` (e.g. anchor="## In Progress\\n\\n" places it
    right under that heading) — or at the end of the document if `anchor`
    is None. Raises `RegionError` if `anchor` is given but not found in
    `text`: guessing a placement for a caller-specified anchor would be
    worse than failing loudly.
    """
    if find_region(text, name) is not None:
        return replace_region(text, name, body)
    block = f"<!-- BEGIN:{name} (generated by sync — do not edit) -->\n{_render_region_content(body)}<!-- END:{name} -->\n"
    if anchor is None:
        if text and not text.endswith("\n"):
            return text + "\n" + block
        return text + block
    idx = text.find(anchor)
    if idx == -1:
        raise RegionError(f"anchor not found for new region {name!r}: {anchor!r}")
    insert_at = idx + len(anchor)
    return text[:insert_at] + block + text[insert_at:]


# ---------------------------------------------------------------------------
# Epic `children` and spec `epics` region renderers
# ---------------------------------------------------------------------------


def _reject_pipe(value: Any, what: str) -> None:
    """Refuse a value that would silently break a markdown table row."""
    if isinstance(value, str) and "|" in value:
        raise RegionError(f"{what} contains '|', which would break a markdown table: {value!r}")


def _epic_progress(children: list[Artifact]) -> tuple[int, int]:
    """(done_count, total_count) for an epic's children.

    `done_count` includes `wont-do` children too ("`done` counts
    `done`+`wont-do`") -- an abandoned task still counts as
    no-longer-outstanding work for progress purposes.
    """
    total = len(children)
    done = sum(1 for c in children if c.fields.get("status") in ("done", "wont-do"))
    return done, total


def render_epic_children(epic: Artifact, children: list[Artifact]) -> str:
    """Render the body of an epic's `children` region: a `| Task | Status |
    Title |` table ordered by id, a blank line, then
    `Progress: <done>/<total> done`.

    `children` should be exactly the tasks whose `epic` field names this
    epic (same contract as `derive_epic_status`) -- this function does not
    filter, only renders. Returns `""` for a childless epic; the region
    engine renders an empty body as `_(none)_`.
    """
    if not children:
        return ""
    ordered = sorted(children, key=lambda task: task.id)
    for task in ordered:
        _reject_pipe(task.fields.get("title"), f"{task.id} title")
    rows = "\n".join(
        f"| {task.id} | {task.fields.get('status')} | {task.fields.get('title')} |"
        for task in ordered
    )
    done, total = _epic_progress(ordered)
    return f"| Task | Status | Title |\n|---|---|---|\n{rows}\n\nProgress: {done}/{total} done"


def render_spec_epics(epics_with_children: list[tuple[Artifact, list[Artifact]]]) -> str:
    """Render the body of a spec's `epics` region: a `| Epic | Status |
    Progress |` table ordered by epic id, mirroring the board's `epics`
    panel format.

    `epics_with_children` is `(epic, epic's children)` pairs for every
    epic whose `spec` field names this spec; each `epic` is expected to
    already carry its *derived* status (i.e. the caller ran
    `derive_epic_status` first — this function only renders, matching
    `render_epic_children`'s division of labor). Returns `""` when there
    are no linked epics.
    """
    if not epics_with_children:
        return ""
    ordered = sorted(epics_with_children, key=lambda pair: pair[0].id)
    rows = []
    for epic, children in ordered:
        _reject_pipe(epic.fields.get("title"), f"{epic.id} title")
        done, total = _epic_progress(children)
        rows.append(f"| {epic.id} | {epic.fields.get('status')} | {done}/{total} done |")
    return "| Epic | Status | Progress |\n|---|---|---|\n" + "\n".join(rows)


# ---------------------------------------------------------------------------
# BOARD.md: epics roll-up panel and fully-generated status columns
# ---------------------------------------------------------------------------


def render_board_epics_panel(epics_with_children: list[tuple[Artifact, list[Artifact]]]) -> str:
    """Render BOARD.md's `epics` roll-up panel: the same shape as
    `render_spec_epics`, restricted to epics whose *current* status is
    not `done` and not `wont-do` — the
    panel shows open work, not a history. Each `epic` is expected to
    already carry its derived status, same contract as `render_spec_epics`.
    """
    active = [
        (epic, children)
        for epic, children in epics_with_children
        if epic.fields.get("status") not in ("done", "wont-do")
    ]
    return render_spec_epics(active)


def render_board_column(tasks: list[Artifact], status: str, cap: int | None = None) -> str:
    """Render one of BOARD.md's fully-generated status columns: a
    `| Task | Title | Epic | Ref |` table of every task in `tasks` whose
    `status` equals `status`, ordered by id.

    `Ref` is the task's `branch` while `in-progress`; its `pr` URL for
    every other status (falling back to `branch` if `pr` isn't set yet,
    e.g. a task bailed out back to `blocked` before ever opening a PR). A
    task with no epic or no ref value shows `—`. If `cap` is given, only
    the highest-id (most recently created) `cap` rows are kept — this is
    how the `done` column stays bounded once `sync archive` starts moving
    old entries out of `.tasks/` (still-discoverable in `.tasks/archive/`,
    but the board shows recent work, not the full history).

    Returns `""` when no task matches; the region engine renders that as
    `_(none)_`.
    """
    matching = sorted((t for t in tasks if t.fields.get("status") == status), key=lambda t: t.id)
    if not matching:
        return ""
    if cap is not None and len(matching) > cap:
        matching = matching[-cap:]
    rows = []
    for task in matching:
        _reject_pipe(task.fields.get("title"), f"{task.id} title")
        epic = task.fields.get("epic") or "—"
        if status == "in-progress":
            ref = task.fields.get("branch") or "—"
        else:
            ref = task.fields.get("pr") or task.fields.get("branch") or "—"
        rows.append(f"| {task.id} | {task.fields.get('title')} | {epic} | {ref} |")
    return "| Task | Title | Epic | Ref |\n|---|---|---|---|\n" + "\n".join(rows)


# ---------------------------------------------------------------------------
# BOARD.md's TODO section: the one place sync merges instead of regenerating
# ---------------------------------------------------------------------------


_TODO_HEADING = "## TODO\n\n"
_TODO_LINE_RE = re.compile(r"^- (TASK-\d+) — ")


def _outstanding_blockers(task: Artifact, tasks: dict[str, Artifact]) -> list[str]:
    """The subset of `task`'s `blocked_by` that isn't satisfied yet.

    `blocked_by` itself is a static, declared dependency list -- nothing
    prunes it as blockers complete (`reconcile_blocks` only ever derives
    `blocks` *from* it, never the reverse). "Is this task still blocked"
    is a display-time question, answered here: a blocker counts as
    satisfied once its `status` is `done` or `wont-do`. A blocker id with
    no matching task (shouldn't happen -- `reconcile_blocks` raises on
    that) is conservatively treated as still outstanding.
    """
    outstanding = []
    for blocker_id in task.fields.get("blocked_by") or []:
        blocker = tasks.get(blocker_id)
        if blocker is None or blocker.fields.get("status") not in ("done", "wont-do"):
            outstanding.append(blocker_id)
    return outstanding


def render_todo_line(task: Artifact, tasks: dict[str, Artifact]) -> str:
    """Render one TODO line: dash, id, em-dash, title, two spaces, the
    epic tag in backticks (omitted when the task has no epic), then
    ' ⛔ blocked_by TASK-A, TASK-B' (ids
    ascending) listing *outstanding* blockers only (see
    `_outstanding_blockers`) when there are any. No trailing newline.

    `tasks` is every loaded task, keyed by id -- needed to look up each
    blocker's current status.
    """
    _reject_pipe(task.fields.get("title"), f"{task.id} title")
    line = f"- {task.id} — {task.fields.get('title')}"
    epic = task.fields.get("epic")
    if epic:
        line += f"  `{epic}`"
    outstanding = _outstanding_blockers(task, tasks)
    if outstanding:
        line += " ⛔ blocked_by " + ", ".join(sorted(outstanding))
    return line


def merge_todo(existing_lines: list[str], tasks: dict[str, Artifact]) -> list[str]:
    """Reconcile the hand-ordered TODO list with reality.

    - existing order is preserved exactly -- never sorted, never reordered
    - a line whose task is no longer `todo` (or no longer exists) is dropped
    - a `todo` task not already listed is appended at the end, in id order
      among the newly-added (not merged into the existing sequence)
    - every kept/appended line is re-rendered fresh via `render_todo_line`,
      so annotations (epic tag, blocked marker) always reflect current data

    `existing_lines` is the TODO section's current lines, in file order;
    anything not matching a `- TASK-NNN — ...` line (blank lines, stray
    prose) is ignored. `tasks` is every loaded task, keyed by id -- both
    to check "is this id still todo" and to find newly-appeared ones.
    Returns the new list of rendered lines (no trailing newlines).
    """
    existing_ids = [m.group(1) for line in existing_lines if (m := _TODO_LINE_RE.match(line))]
    kept = [tid for tid in existing_ids if tid in tasks and tasks[tid].fields.get("status") == "todo"]
    already_listed = set(kept)
    newly_added = sorted(
        tid for tid, task in tasks.items()
        if task.fields.get("status") == "todo" and tid not in already_listed
    )
    return [render_todo_line(tasks[tid], tasks) for tid in kept + newly_added]


def apply_todo_merge(board_text: str, tasks: dict[str, Artifact]) -> str:
    """Reconcile BOARD.md's TODO section in place via `merge_todo`.

    Only the lines between `## TODO\\n\\n` and the next `## ` heading
    change; the heading itself and the rest of the file are untouched.
    Raises `RegionError` if the `## TODO` heading isn't present.
    """
    if _TODO_HEADING not in board_text:
        raise RegionError("no '## TODO' heading found")
    start = board_text.index(_TODO_HEADING) + len(_TODO_HEADING)
    # Search from `start - 1`, not `start`: `_TODO_HEADING` always ends in
    # the blank line's own "\n", so when the TODO section is completely
    # empty and a heading follows immediately, that heading's leading "\n"
    # sits at `start - 1` -- one before `start`. Searching from `start`
    # missed that "\n" entirely, so `next_heading` came back -1 (no match
    # anywhere in the rest of the file) and everything from the very next
    # heading onward -- that heading included -- was silently discarded as
    # if it were unrecognised TODO-line text. A freshly-scaffolded board
    # with zero TODO items hits this on the very first `sync` run.
    next_heading = board_text.find("\n## ", start - 1)
    end = len(board_text) if next_heading == -1 else next_heading + 1
    existing_lines = board_text[start:end].splitlines()
    merged = merge_todo(existing_lines, tasks)
    body = "".join(line + "\n" for line in merged)
    # A blank line separates the section from the next heading; if TODO is
    # the last section (no next heading), there is nothing to separate.
    trailer = "\n" if next_heading != -1 else ""
    return board_text[:start] + body + trailer + board_text[end:]


# ---------------------------------------------------------------------------
# sync check: compute everything in memory, diff against disk, write nothing
# ---------------------------------------------------------------------------


@dataclass(frozen=True)
class Mismatch:
    """One place a file on disk disagrees with what `sync` would produce.

    `current`/`expected` are the *whole* file content (not just the
    changed region) so `diff()` reads naturally in a unified diff; most
    mismatches differ in only one region, since each is computed via
    `replace_region`/`ensure_region`, which touch nothing else.
    """

    path: Path
    region: str
    current: str
    expected: str

    def diff(self) -> str:
        return "".join(
            difflib.unified_diff(
                self.current.splitlines(keepends=True),
                self.expected.splitlines(keepends=True),
                fromfile=f"{self.path} [{self.region}]",
                tofile=f"{self.path} [{self.region}] (expected)",
            )
        )


def _apply_region(text: str, name: str, expected_body: str) -> str:
    """Return `text` with region `name` set to `expected_body`, appending
    it at end-of-file if it doesn't exist yet.
    """
    try:
        return replace_region(text, name, expected_body)
    except RegionError:
        return ensure_region(text, name, expected_body)


def _diff_region(path: Path, text: str, name: str, expected_body: str) -> Mismatch | None:
    """Compare `text`'s `name` region against `expected_body` (see
    `_apply_region`). `None` if they already agree.
    """
    replaced = _apply_region(text, name, expected_body)
    if replaced == text:
        return None
    return Mismatch(path=path, region=name, current=text, expected=replaced)


_DONE_COLUMN_CAP = 20


def compute_mismatches(tasks_root: Path) -> list[Mismatch]:
    """Run every derivation and renderer this module builds, in memory, and
    report everywhere the result disagrees with what's on disk. Never
    writes anything -- this is the shared core `sync check` is built on;
    the write mode applies these same `Mismatch.expected` values instead
    of only reporting them.

    Covers: epic `children` regions, spec `epics` regions, the board
    `epics` panel, the four board columns, the TODO merge, and epic
    `status` frontmatter. Also checks task `blocks` against
    `reconcile_blocks` -- every derivation needs checking, and skipping
    this one would leave a real class of drift undetected.
    """
    artifacts = discover(tasks_root)
    tasks = {a.id: a for a in artifacts.values() if a.kind == "task"}
    epics = {a.id: a for a in artifacts.values() if a.kind == "epic"}
    specs = {a.id: a for a in artifacts.values() if a.kind == "spec"}

    mismatches: list[Mismatch] = []

    # blocks reconciliation (frontmatter, not a region)
    reconciled = reconcile_blocks(tasks)
    for task_id, art in tasks.items():
        want = reconciled[task_id].fields["blocks"]
        if (art.fields.get("blocks") or []) != want:
            mismatches.append(
                Mismatch(
                    path=art.path,
                    region="blocks (frontmatter)",
                    current=render_frontmatter(art.fields, art.order),
                    expected=render_frontmatter(reconciled[task_id].fields, reconciled[task_id].order),
                )
            )

    # epic status (frontmatter) + children region, per epic
    children_of: dict[str, list[Artifact]] = {epic_id: [] for epic_id in epics}
    for task in tasks.values():
        epic_id = task.fields.get("epic")
        if epic_id in children_of:
            children_of[epic_id].append(task)

    derived_epics: dict[str, Artifact] = {}
    for epic_id, epic in epics.items():
        children = children_of[epic_id]
        derived = derive_epic_status(epic, children)
        derived_epics[epic_id] = derived
        if derived.fields.get("status") != epic.fields.get("status"):
            mismatches.append(
                Mismatch(
                    path=epic.path,
                    region="status (frontmatter)",
                    current=render_frontmatter(epic.fields, epic.order),
                    expected=render_frontmatter(derived.fields, derived.order),
                )
            )
        epic_text = epic.path.read_text()
        mismatch = _diff_region(epic.path, epic_text, "children", render_epic_children(derived, children))
        if mismatch:
            mismatches.append(mismatch)

    # spec epics region, per spec (using each epic's *derived* status)
    for spec_id, spec in specs.items():
        linked = [
            (derived_epics[epic_id], children_of[epic_id])
            for epic_id, epic in epics.items()
            if epic.fields.get("spec") == spec_id
        ]
        spec_text = spec.path.read_text()
        mismatch = _diff_region(spec.path, spec_text, "epics", render_spec_epics(linked))
        if mismatch:
            mismatches.append(mismatch)

    # BOARD.md: epics panel, four columns, TODO merge
    board_path = tasks_root / "BOARD.md"
    board_text = board_path.read_text()
    all_pairs = [(derived_epics[epic_id], children_of[epic_id]) for epic_id in epics]

    mismatch = _diff_region(board_path, board_text, "epics", render_board_epics_panel(all_pairs))
    if mismatch:
        mismatches.append(mismatch)

    for status, cap in (("in-progress", None), ("in-review", None), ("blocked", None), ("done", _DONE_COLUMN_CAP)):
        mismatch = _diff_region(board_path, board_text, status, render_board_column(list(tasks.values()), status, cap=cap))
        if mismatch:
            mismatches.append(mismatch)

    merged_board = apply_todo_merge(board_text, tasks)
    if merged_board != board_text:
        mismatches.append(Mismatch(path=board_path, region="TODO", current=board_text, expected=merged_board))

    return mismatches


def run_check(tasks_root: Path) -> int:
    """`sync check`: print a unified diff per mismatch, write nothing.
    Returns the process exit code -- 0 when clean, 1 when drift is found.
    """
    mismatches = compute_mismatches(tasks_root)
    for mismatch in mismatches:
        print(mismatch.diff(), end="")
    return 1 if mismatches else 0


# ---------------------------------------------------------------------------
# Bare `sync`: the write mode
# ---------------------------------------------------------------------------
#
# `compute_mismatches` covers read-only diagnosis; the write mode below
# applies the same `Mismatch.expected` values it reports. Needed so an
# idempotency test ("run sync, then sync again, confirm the second run is
# a no-op") has something that actually writes to exercise.


def load_config(tasks_root: Path) -> dict[str, Any]:
    """Load `.tasks/config.md`'s frontmatter fields, or `{}` if the file
    doesn't exist yet (a repo mid-bootstrap, or a test fixture that
    doesn't need one -- `should_auto_archive({})` still defaults `True`).
    """
    config_path = tasks_root / "config.md"
    if not config_path.is_file():
        return {}
    fields, _body, _order = parse_frontmatter(config_path.read_text())
    return fields


def apply_all(tasks_root: Path) -> list[Path]:
    """Write every region/frontmatter update `compute_mismatches` would
    otherwise only report, and return the paths actually changed.

    Unlike `compute_mismatches` -- which diffs each region independently
    against the pristine on-disk text, so a per-region diff always names
    exactly what changed -- this function must *chain* a file's updates
    when more than one applies to it (BOARD.md can need all of: the epics
    panel, all four columns, and the TODO merge). Applying each against
    the original text independently and writing them in sequence would
    let a later write silently undo an earlier one; chaining through a
    running `text` per file avoids that. Does not archive -- see
    `run_sync`.
    """
    artifacts = discover(tasks_root)
    tasks = {a.id: a for a in artifacts.values() if a.kind == "task"}
    epics = {a.id: a for a in artifacts.values() if a.kind == "epic"}
    specs = {a.id: a for a in artifacts.values() if a.kind == "spec"}
    changed: list[Path] = []

    # blocks reconciliation (frontmatter)
    reconciled = reconcile_blocks(tasks)
    for task_id, art in tasks.items():
        new_blocks = reconciled[task_id].fields["blocks"]
        if new_blocks != (art.fields.get("blocks") or []):
            new_fields = {**art.fields, "blocks": new_blocks}
            art.path.write_text(render_frontmatter(new_fields, art.order) + art.body)
            changed.append(art.path)

    # epic status (frontmatter) + children region, chained per epic
    children_of: dict[str, list[Artifact]] = {epic_id: [] for epic_id in epics}
    for task in tasks.values():
        epic_id = task.fields.get("epic")
        if epic_id in children_of:
            children_of[epic_id].append(task)

    derived_epics: dict[str, Artifact] = {}
    for epic_id, epic in epics.items():
        children = children_of[epic_id]
        derived = derive_epic_status(epic, children)
        derived_epics[epic_id] = derived
        original_text = epic.path.read_text()
        text = original_text
        if derived.fields.get("status") != epic.fields.get("status"):
            text = render_frontmatter(derived.fields, derived.order) + epic.body
        text = _apply_region(text, "children", render_epic_children(derived, children))
        if text != original_text:
            epic.path.write_text(text)
            changed.append(epic.path)

    # spec epics region, per spec
    for spec_id, spec in specs.items():
        linked = [
            (derived_epics[epic_id], children_of[epic_id])
            for epic_id, epic in epics.items()
            if epic.fields.get("spec") == spec_id
        ]
        original_text = spec.path.read_text()
        text = _apply_region(original_text, "epics", render_spec_epics(linked))
        if text != original_text:
            spec.path.write_text(text)
            changed.append(spec.path)

    # BOARD.md: chain the epics panel, all four columns, and the TODO merge
    board_path = tasks_root / "BOARD.md"
    original_board_text = board_path.read_text()
    board_text = original_board_text
    all_pairs = [(derived_epics[epic_id], children_of[epic_id]) for epic_id in epics]
    board_text = _apply_region(board_text, "epics", render_board_epics_panel(all_pairs))
    for status, cap in (("in-progress", None), ("in-review", None), ("blocked", None), ("done", _DONE_COLUMN_CAP)):
        board_text = _apply_region(board_text, status, render_board_column(list(tasks.values()), status, cap=cap))
    board_text = apply_todo_merge(board_text, tasks)
    if board_text != original_board_text:
        board_path.write_text(board_text)
        changed.append(board_path)

    return changed


def run_sync(tasks_root: Path) -> list[Path]:
    """Bare `sync`: write every derived region and frontmatter field via
    `apply_all`, then archive `done`/`wont-do` tasks if `config.md`'s
    `archive_done` allows it (default: yes). Returns every path changed
    or moved.
    """
    changed = apply_all(tasks_root)
    if should_auto_archive(load_config(tasks_root)):
        changed += archive(tasks_root)
    return changed


def main(argv: list[str]) -> int:
    tasks_root = Path(__file__).resolve().parent.parent
    if not argv:
        changed = run_sync(tasks_root)
        if changed:
            print(f"Updated {len(changed)} file(s):")
            for path in changed:
                print(f"  {path.relative_to(tasks_root)}")
        else:
            print("Already up to date.")
        return 0
    if argv == ["check"]:
        return run_check(tasks_root)
    if len(argv) == 2 and argv[0] == "next-id":
        try:
            print(next_id(tasks_root, argv[1]))
        except ValueError as exc:
            print(f"sync next-id: {exc}", file=sys.stderr)
            return 2
        return 0
    if argv == ["archive"]:
        moved = archive(tasks_root)
        if moved:
            print(f"Archived {len(moved)} task(s):")
            for path in moved:
                print(f"  {path.relative_to(tasks_root)}")
        else:
            print("Nothing to archive.")
        return 0
    print(
        f"sync: unknown arguments {argv!r} — supported: (none), check, next-id <spec|epic|task>, archive",
        file=sys.stderr,
    )
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
